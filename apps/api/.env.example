NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgresql://academy:academy@localhost:5432/backend_academy

WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# The web app proxies /api/* to this server, so trust one proxy hop for client IPs.
TRUST_PROXY=true

# Mailpit from docker compose. Leave unset to print emails to the API log.
# SMTP_URL=smtp://localhost:1025
MAIL_FROM="Backend Academy <no-reply@backend.academy>"

SEED_ADMIN_EMAIL=admin@backend.academy
SEED_ADMIN_PASSWORD=change-me-admin-1
